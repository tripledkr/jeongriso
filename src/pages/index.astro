---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import LatestColumns from '../components/LatestColumns.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import site from '../site.config.mjs';

const faqs = [
  { q: '아임웹 홈페이지 제작은 얼마나 걸리나요?', a: '상담부터 오픈까지 6주를 기준으로 진행합니다. 페이지 수와 자료 준비 상황에 따라 조정될 수 있습니다.' },
  { q: '아임웹 이용료는 제작비와 별도인가요?', a: '네, 아임웹 요금제와 도메인 비용은 사이트를 운영하는 회사 명의로 결제하는 별도 비용입니다. 필요한 요금제와 항목은 상담할 때 미리 안내합니다.' },
  { q: '오픈 후에 직접 수정할 수 있나요?', a: '아임웹 관리자에서 문구, 이미지, 게시글을 직접 수정할 수 있도록 구조를 잡고, 오픈할 때 1:1로 사용법을 안내합니다.' },
  { q: '이미 아임웹으로 만든 홈페이지도 정리해 주나요?', a: '가능합니다. 지금 사이트의 구조와 디자인을 검토해서 메뉴 정리, 모바일 화면, 디자인 개선을 진행합니다.' },
  { q: 'AI로 홈페이지를 만드는 것과 뭐가 다른가요?', a: 'AI 홈페이지 빌더는 빠르고 저렴합니다. 다만 회사의 실적이나 인증 같은 자료는 반영되지 않아 어느 회사에나 쓸 수 있는 문장이 남고, 문의로 이어지는 동선과 게시판·알림·검색엔진 등록 같은 운영 세팅은 따로 해야 합니다. 한 장짜리 소개 페이지라면 AI 쪽이 맞고, 회사 이름으로 몇 년을 쓸 홈페이지라면 구조부터 설계하는 편이 낫습니다.' },
  { q: '아임웹 템플릿 느낌이 나지 않게 만들 수 있나요?', a: '레이아웃과 여백, 글자 크기를 회사에 맞게 다시 설계하고, 필요한 부분은 커스텀 코드로 다듬어 기본 템플릿과 다른 완성도로 만듭니다.' },
  { q: '사이트 계정과 소유권은 누구에게 있나요?', a: '아임웹 사이트와 도메인은 회사 계정으로 만들어 운영 권한이 회사에 남도록 진행합니다.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'ko-KR' },
  {
    '@context': 'https://schema.org', '@type': 'Service',
    name: '아임웹 홈페이지 제작', serviceType: '아임웹 홈페이지 제작',
    description: '아임웹으로 회사 홈페이지를 기획, 디자인, 세팅하고 담당자가 직접 운영할 수 있도록 교육까지 진행하는 서비스',
    areaServed: 'KR',
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url, telephone: site.contact.tel, email: site.contact.email },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="아임웹 홈페이지 제작 | 직접 수정하는 회사 홈페이지 - 홈페이지 정리소"
  description="아임웹 홈페이지 제작부터 운영 교육까지. 홈페이지 정리소는 회사 담당자가 오픈 후 직접 문구와 이미지를 수정할 수 있도록 아임웹 홈페이지를 정리해서 만들어 드립니다."
  schema={schema}
>
  <!-- 히어로 -->
  <section class="hero hero--dark">
    <div class="hero__bg" style="background-image:url('/hero.webp')" aria-hidden="true"></div>
    <div class="hero__veil" aria-hidden="true"></div>
    <div class="inner">
      <p class="hero__kw" data-reveal>회사 홈페이지 제작</p>
      <h1 class="h1" data-reveal>만들어만 주고 끝나는<br>홈페이지는 만들지 않습니다.</h1>
      <p class="lead" data-reveal>기획과 디자인, 제작까지 맡기고 오픈 후에는 담당자가 직접 운영합니다. 문구 하나 바꾸려고 제작 업체에 연락하지 않아도 되도록, 구조부터 정리해서 만들어 드립니다.</p>
      <div class="hero__btns" data-reveal>
        <a class="btn" href="#contact">무료 제작 상담 →</a>
        <a class="btn btn--line" href="#fit">우리 회사에 맞을까?</a>
      </div>
      <ul class="hero__points" data-reveal-group>
        <li><strong>맞춤 설계</strong><span>템플릿 느낌 없는 구조와 디자인</span></li>
        <li><strong>직접 수정 교육</strong><span>오픈할 때 1:1 사용법 안내</span></li>
        <li><strong>회사 명의 운영</strong><span>계정과 운영 권한은 회사에</span></li>
      </ul>
    </div>
  </section>


  <!-- 수치 -->
  <section class="statbar" aria-label="주요 수치">
    <div class="inner">
      <ul class="statbar__in" data-reveal-group>
        <li><strong><span class="num" data-count="60">60</span><small>+</small></strong><span>운영 관리 중인 사이트</span></li>
        <li><strong><span class="num" data-count="6">6</span><small>주</small></strong><span>상담부터 오픈까지</span></li>
        <li><strong><span class="num" data-count="2">2</span><small>개월</small></strong><span>오픈 후 무상 케어</span></li>
      </ul>
    </div>
  </section>
  <!-- 잘 맞는 회사 -->
  <section class="sec sec--soft" id="fit" aria-labelledby="fit-title">
    <div class="inner split">
      <div class="split__l" data-reveal>
        <p class="label">CHECK</p>
        <h2 id="fit-title" class="h2">이런 회사라면,<br>아임웹이 잘 맞습니다.</h2>
        <span class="head__en">Is it a good fit?</span>
        <p class="split__note">아임웹이 모든 회사에 맞는 도구는 아닙니다.<br class="br-pc">아래 항목에 공감되는 게 많을수록 잘 맞습니다.</p>
      </div>
      <ol class="signs" data-reveal-group>
        <li><span class="signs__n">01</span><p>개발자 없이 담당자가 직접 내용을 고치고 싶다</p></li>
        <li><span class="signs__n">02</span><p>서버나 보안 관리는 신경 쓰고 싶지 않다</p></li>
        <li><span class="signs__n">03</span><p>게시판, 문의폼, 예약 같은 기본 기능이 필요하다</p></li>
        <li><span class="signs__n">04</span><p>나중에 상품 판매까지 붙일 수도 있다</p></li>
        <li><span class="signs__n">05</span><p>너무 오래 걸리지 않게 오픈하고 싶다</p></li>
        <li><span class="signs__n">06</span><p>운영 비용을 예측할 수 있었으면 좋겠다</p></li>
      </ol>
    </div>
  </section>

  <!-- 혼자 만들 때 막히는 부분 -->
  <section class="sec" id="scope" aria-labelledby="stuck-title">
    <div class="inner">
      <div class="head head--split" data-reveal>
        <div>
          <p class="label">WHY US</p>
          <h2 id="stuck-title" class="h2">아임웹, 혼자 만들면<br>여기서 막힙니다.</h2>
          <span class="head__en">Where DIY stalls</span>
        </div>
        <p class="lead">아임웹은 쉬운 도구지만, 회사 홈페이지다운 완성도를 내는 건 또 다른 일입니다. 막히는 지점은 대체로 여섯 가지로 비슷합니다.</p>
      </div>
      <BeforeAfter
        beforeLabel="혼자 만들 때"
        afterLabel="맡길 때"
        beforeCaption="템플릿 메뉴를 그대로 쓰다 보니 내용이 쌓이기만 하고, 무엇을 보여줄지 정리되지 않습니다."
        afterCaption="메뉴와 페이지를 회사에 맞게 다시 나누고, 문의까지 이어지는 흐름을 만듭니다."
      />
      <ol class="grid6">
        <li data-reveal>
          <span class="grid6__n">01</span>
          <h3 class="grid6__t">템플릿 느낌이 난다</h3>
          <p class="grid6__d">여백과 글자 크기, 배치를 회사에 맞게 다시 설계해 템플릿과 다른 완성도를 만듭니다.</p>
        </li>
        <li data-reveal>
          <span class="grid6__n">02</span>
          <h3 class="grid6__t">메뉴를 어떻게 나눌지 모르겠다</h3>
          <p class="grid6__d">방문자가 찾는 순서대로 메뉴와 페이지 구조를 먼저 정리합니다.</p>
        </li>
        <li data-reveal>
          <span class="grid6__n">03</span>
          <h3 class="grid6__t">모바일에서 어색하다</h3>
          <p class="grid6__d">PC와 모바일 화면을 따로 확인하며 글자 크기와 배치를 맞춥니다.</p>
        </li>
        <li data-reveal>
          <span class="grid6__n">04</span>
          <h3 class="grid6__t">기능 설정이 복잡하다</h3>
          <p class="grid6__d">게시판, 문의폼, 알림 설정까지 회사 운영 방식에 맞게 세팅합니다.</p>
        </li>
        <li data-reveal>
          <span class="grid6__n">05</span>
          <h3 class="grid6__t">검색 설정을 놓친다</h3>
          <p class="grid6__d">페이지별 제목과 설명, 공유 이미지, 검색엔진 등록까지 챙깁니다.</p>
        </li>
        <li data-reveal>
          <span class="grid6__n">06</span>
          <h3 class="grid6__t">오픈 후 손을 못 댄다</h3>
          <p class="grid6__d">자주 고치는 부분 위주로 관리 방법을 1:1로 안내합니다.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 비교 -->
  <!-- AI 홈페이지와의 차이 -->
  <section class="sec sec--soft" id="vs-ai" aria-labelledby="ai-title">
    <div class="inner">
      <div class="head head--split" data-reveal>
        <div>
          <p class="label">AI VS US</p>
          <h2 id="ai-title" class="h2">AI로 만든 홈페이지와<br>무엇이 다른가요?</h2>
          <span class="head__en">What AI builders miss</span>
        </div>
        <p class="lead">먼저 솔직하게 말씀드리면, AI 홈페이지 빌더는 빠르고 저렴합니다. 몇 분이면 한 페이지가 나옵니다. 다만 회사 홈페이지로 몇 년을 쓰기에는 비어 있는 자리가 있습니다.</p>
      </div>

      <div class="vs" data-reveal>
        <div class="vs__col vs__col--a">
          <p class="vs__h">AI 홈페이지 빌더</p>
          <ol class="vs__list">
            <li><b>결과물이 서로 닮습니다</b><span>학습한 패턴 안에서 만들어지다 보니 업종이 달라도 구조와 문장이 비슷해집니다. 경쟁사와 같은 인상을 주게 됩니다.</span></li>
            <li><b>회사 자료가 들어가지 않습니다</b><span>준공 실적, 인증, 공정, 거래처처럼 회사를 설명하는 자료는 AI가 알지 못합니다. 결국 어느 회사에나 쓸 수 있는 문장이 남습니다.</span></li>
            <li><b>문의까지 가는 길이 없습니다</b><span>페이지는 만들어지지만, 방문자가 서비스를 읽고 상담으로 이어지는 동선은 따로 설계해야 하는 영역입니다.</span></li>
            <li><b>오픈 다음이 비어 있습니다</b><span>게시판, 문의 알림, 검색엔진 등록, 수정 방법. 실제로 운영하려면 필요한 것들은 사람이 세팅해야 합니다.</span></li>
          </ol>
        </div>
        <div class="vs__col vs__col--b">
          <p class="vs__h vs__h--on">홈페이지 정리소</p>
          <ol class="vs__list">
            <li><b>회사 자료를 먼저 읽습니다</b><span>가지고 계신 회사소개서, 사진, 실적 자료를 받아 무엇을 앞에 둘지부터 정합니다.</span></li>
            <li><b>업종과 규모에 맞게 설계합니다</b><span>방문자가 궁금해하는 순서대로 메뉴와 페이지를 나눕니다. 같은 템플릿을 두 번 쓰지 않습니다.</span></li>
            <li><b>서비스를 읽은 자리에 버튼을 둡니다</b><span>문의로 이어지는 지점을 정해서 배치하고, 폼으로 들어온 내용이 담당자에게 바로 전달되게 연결합니다.</span></li>
            <li><b>오픈 후를 함께 준비합니다</b><span>검색엔진 등록까지 마치고, 관리자에서 무엇을 어떻게 고치는지 1:1로 안내합니다.</span></li>
          </ol>
        </div>
      </div>

      <p class="vs__note">AI 빌더가 나쁜 도구라는 뜻은 아닙니다. 한 장짜리 소개 페이지가 빨리 필요하다면 그쪽이 더 맞습니다. 회사 이름으로 몇 년을 쓸 홈페이지라면 이야기가 달라집니다.</p>
    </div>
  </section>

  <!-- 사진 띠 -->
  <section class="band band--photo sec--lift" aria-label="핵심 메시지">
    <div class="band__bg" aria-hidden="true"></div>
    <div class="inner">
      <p>홈페이지는 만드는 날보다<br><em>고치는 날</em>이 훨씬 많습니다.</p>
      <span>Built to be maintained, not just launched.</span>
    </div>
  </section>

  <!-- 왜 아임웹인가 -->
  <section class="sec" id="builder" aria-labelledby="builder-title">
    <div class="inner">
      <div class="head head--split" data-reveal>
        <div>
          <p class="label">WHY IMWEB</p>
          <h2 id="builder-title" class="h2">왜 아임웹으로<br>만드나요?</h2>
          <span class="head__en">Our platform of choice</span>
        </div>
        <p class="lead">홈페이지 정리소는 대부분의 회사 홈페이지를 아임웹으로 제작합니다. 디자인이나 기획을 아임웹에 맞추는 게 아니라, 오픈 다음에 회사가 직접 운영할 수 있다는 이유 때문입니다.</p>
      </div>
      <ol class="grid6 grid6--4">
        <li data-reveal><span class="grid6__n">01</span><h3 class="grid6__t">담당자가 직접 고칩니다</h3><p class="grid6__d">관리자 화면에서 문구와 이미지, 게시글을 바로 수정합니다. 코드를 몰라도 되고, 제작 업체에 연락하지 않아도 됩니다.</p></li>
        <li data-reveal><span class="grid6__n">02</span><h3 class="grid6__t">서버와 보안을 신경 쓰지 않습니다</h3><p class="grid6__d">호스팅, 백업, 보안 인증서가 요금제에 포함됩니다. 사이트가 멈추거나 인증서가 만료되는 일을 회사가 관리하지 않아도 됩니다.</p></li>
        <li data-reveal><span class="grid6__n">03</span><h3 class="grid6__t">필요한 기능이 이미 있습니다</h3><p class="grid6__d">게시판, 문의폼, 예약, 회원, 결제가 기본으로 제공됩니다. 나중에 상품 판매를 붙일 때도 사이트를 새로 만들지 않습니다.</p></li>
        <li data-reveal><span class="grid6__n">04</span><h3 class="grid6__t">비용이 예측됩니다</h3><p class="grid6__d">월 요금제와 도메인 비용이 정해져 있어 운영비를 미리 계산할 수 있습니다. 사이트와 도메인은 회사 명의로 만듭니다.</p></li>
      </ol>
      <p class="vs__note">다만 아임웹이 모든 경우에 맞지는 않습니다. 복잡한 연동이나 자체 시스템이 필요하다면 별도 개발이 맞고, 상담할 때 그렇게 말씀드립니다.</p>
    </div>
  </section>

  <!-- 진행 과정 -->
  <section class="sec sec--dark" id="process" aria-labelledby="process-title">
    <div class="inner">
      <div class="head" data-reveal>
        <p class="label">PROCESS</p>
        <h2 id="process-title" class="h2">아임웹 홈페이지 제작,<br>이렇게 진행됩니다.</h2>
        <span class="head__en">How we work</span>
      </div>
      <ol class="steps">
        <li><b>STEP 1</b><h3>상담 · 자료 정리</h3><p>필요한 메뉴와 자료를 함께 정리합니다.</p></li>
        <li><b>STEP 2</b><h3>구조 설계</h3><p>메뉴와 페이지별 내용을 설계합니다.</p></li>
        <li><b>STEP 3</b><h3>디자인</h3><p>시안으로 방향을 맞추고 수정합니다.</p></li>
        <li><b>STEP 4</b><h3>아임웹 세팅</h3><p>디자인을 아임웹에 구현하고 기능을 설정합니다.</p></li>
