---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import LatestColumns from '../components/LatestColumns.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import site from '../site.config.mjs';

const faqs = [
  { q: '아임웹 홈페이지 제작은 얼마나 걸리나요?', a: '상담부터 오픈까지 6주를 기준으로 진행합니다. 페이지 수와 자료 준비 상황에 따라 조정될 수 있습니다.' },
  { q: '아임웹 이용료는 제작비와 별도인가요?', a: '네, 아임웹 요금제와 도메인 비용은 사이트를 운영하는 회사 명의로 결제하는 별도 비용입니다. 필요한 요금제와 항목은 상담할 때 미리 안내합니다.' },
  { q: '오픈 후에 직접 수정할 수 있나요?', a: '아임웹 관리자에서 문구, 이미지, 게시글을 직접 수정할 수 있도록 구조를 잡고, 오픈할 때 1:1로 사용법을 안내합니다.' },
  { q: '이미 아임웹으로 만든 홈페이지도 정리해 주나요?', a: '가능합니다. 지금 사이트의 구조와 디자인을 검토해서 메뉴 정리, 모바일 화면, 디자인 개선을 진행합니다.' },
  { q: '아임웹 템플릿 느낌이 나지 않게 만들 수 있나요?', a: '레이아웃과 여백, 글자 크기를 회사에 맞게 다시 설계하고, 필요한 부분은 커스텀 코드로 다듬어 기본 템플릿과 다른 완성도로 만듭니다.' },
  { q: '사이트 계정과 소유권은 누구에게 있나요?', a: '아임웹 사이트와 도메인은 회사 계정으로 만들어 운영 권한이 회사에 남도록 진행합니다.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'ko-KR' },
  {
    '@context': 'https://schema.org', '@type': 'Service',
    name: '아임웹 홈페이지 제작', serviceType: '아임웹 홈페이지 제작',
    description: '아임웹으로 회사 홈페이지를 기획, 디자인, 세팅하고 담당자가 직접 운영할 수 있도록 교육까지 진행하는 서비스',
    areaServed: 'KR',
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url, telephone: site.contact.tel, email: site.contact.email },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="아임웹 홈페이지 제작 | 직접 수정하는 회사 홈페이지 - 홈페이지 정리소"
  description="아임웹 홈페이지 제작부터 운영 교육까지. 홈페이지 정리소는 회사 담당자가 오픈 후 직접 문구와 이미지를 수정할 수 있도록 아임웹 홈페이지를 정리해서 만들어 드립니다."
  schema={schema}
>
  <!-- 히어로 -->
  <section class="hero hero--dark">
    <div class="hero__bg" style="background-image:url('/hero.webp')" aria-hidden="true"></div>
    <div class="hero__veil" aria-hidden="true"></div>
    <div class="inner">
      <p class="hero__kw" data-reveal>아임웹 홈페이지 제작</p>
      <h1 class="h1" data-reveal>아임웹으로 만들고,<br>회사에서 직접 고치는 홈페이지.</h1>
      <p class="lead" data-reveal>아임웹 홈페이지 제작부터 운영 교육까지 한 번에. 오픈 후에는 담당자가 문구와 이미지를 직접 수정할 수 있게 구조부터 정리해서 만들어 드립니다.</p>
      <div class="hero__btns" data-reveal>
        <a class="btn" href="#contact">무료 제작 상담 →</a>
        <a class="btn btn--line" href="#fit">우리 회사에 맞을까?</a>
      </div>
      <ul class="hero__points" data-reveal-group>
        <li><strong>아임웹 전문 제작</strong><span>템플릿 느낌 없는 맞춤 디자인</span></li>
        <li><strong>직접 수정 교육</strong><span>오픈할 때 1:1 사용법 안내</span></li>
        <li><strong>회사 명의 운영</strong><span>계정과 운영 권한은 회사에</span></li>
      </ul>
    </div>
  </section>


  <!-- 수치 -->
  <section class="statbar" aria-label="주요 수치">
    <div class="inner">
      <ul class="statbar__in" data-reveal-group>
        <li><strong><span class="num" data-count="60">60</span><small>+</small></strong><span>운영 관리 중인 사이트</span></li>
        <li><strong><span class="num" data-count="6">6</span><small>주</small></strong><span>상담부터 오픈까지</span></li>
        <li><strong><span class="num" data-count="2">2</span><small>개월</small></strong><span>오픈 후 무상 케어</span></li>
      </ul>
    </div>
  </section>
  <!-- 잘 맞는 회사 -->
  <section class="sec sec--soft" id="fit" aria-labelledby="fit-title">
    <div class="inner">
      <div class="head" data-reveal>
        <p class="label">CHECK</p>
        <h2 id="fit-title" class="h2">이런 회사라면,<br>아임웹 홈페이지가 잘 맞습니다.</h2>
      </div>
      <ul class="checks" data-reveal-group>
        <li>개발자 없이 담당자가 직접 내용을 고치고 싶다</li>
        <li>서버나 보안 관리는 신경 쓰고 싶지 않다</li>
        <li>게시판, 문의폼, 예약 같은 기본 기능이 필요하다</li>
        <li>나중에 상품 판매까지 붙일 수도 있다</li>
        <li>너무 오래 걸리지 않게 오픈하고 싶다</li>
        <li>운영 비용을 예측할 수 있었으면 좋겠다</li>
      </ul>
    </div>
  </section>

  <!-- 혼자 만들 때 막히는 부분 -->
  <section class="sec" id="scope" aria-labelledby="stuck-title">
    <div class="inner">
      <div class="head" data-reveal>
        <p class="label">WHY US</p>
        <h2 id="stuck-title" class="h2">아임웹, 혼자 만들면<br>여기서 막힙니다.</h2>
        <p class="lead">아임웹은 쉬운 도구지만, 회사 홈페이지다운 완성도를 내는 건 또 다른 일입니다.</p>
      </div>
      <BeforeAfter
        beforeLabel="혼자 만들 때"
        afterLabel="맡길 때"
        beforeCaption="템플릿 메뉴를 그대로 쓰다 보니 내용이 쌓이기만 하고, 무엇을 보여줄지 정리되지 않습니다."
        afterCaption="메뉴와 페이지를 회사에 맞게 다시 나누고, 문의까지 이어지는 흐름을 만듭니다."
      />
      <ul class="cards" data-reveal-group>
        <li class="card"><span class="card__no">01</span><h3>템플릿 느낌이 난다</h3><p>여백과 글자 크기, 배치를 회사에 맞게 다시 설계해 템플릿과 다른 완성도를 만듭니다.</p></li>
        <li class="card"><span class="card__no">02</span><h3>메뉴를 어떻게 나눌지 모르겠다</h3><p>방문자가 찾는 순서대로 메뉴와 페이지 구조를 먼저 정리합니다.</p></li>
        <li class="card"><span class="card__no">03</span><h3>모바일에서 어색하다</h3><p>PC와 모바일 화면을 따로 확인하며 글자와 배치를 맞춥니다.</p></li>
        <li class="card"><span class="card__no">04</span><h3>기능 설정이 복잡하다</h3><p>게시판, 문의폼, 알림 설정까지 회사 운영 방식에 맞게 세팅합니다.</p></li>
        <li class="card"><span class="card__no">05</span><h3>검색 설정을 놓친다</h3><p>페이지별 제목과 설명, 공유 이미지, 검색엔진 등록까지 챙깁니다.</p></li>
        <li class="card"><span class="card__no">06</span><h3>오픈 후 손을 못 댄다</h3><p>자주 고치는 부분 위주로 관리 방법을 1:1로 안내합니다.</p></li>
      </ul>
    </div>
  </section>

  <!-- 비교 -->
  <section class="sec sec--soft" aria-labelledby="compare-title">
    <div class="inner">
      <div class="head" data-reveal>
        <p class="label">COMPARE</p>
        <h2 id="compare-title" class="h2">혼자 만들 때와 맡길 때,<br>이렇게 다릅니다.</h2>
      </div>
      <div class="table-wrap" data-reveal>
        <table class="compare">
          <caption class="skip">아임웹 홈페이지를 혼자 만들 때와 맡길 때 비교</caption>
          <thead><tr><th scope="col">항목</th><th scope="col">혼자 만들 때</th><th scope="col">홈페이지 정리소</th></tr></thead>
          <tbody>
            <tr><th scope="row">구조</th><td>템플릿 메뉴를 그대로 사용</td><td class="is-good">회사에 맞게 메뉴와 페이지 재설계</td></tr>
            <tr><th scope="row">디자인</th><td>템플릿 기본 디자인</td><td class="is-good">맞춤 레이아웃 + 커스텀 코드 보완</td></tr>
            <tr><th scope="row">문구</th><td>직접 작성</td><td class="is-good">자료를 바탕으로 카피 정리</td></tr>
            <tr><th scope="row">검색 설정</th><td>놓치기 쉬움</td><td class="is-good">페이지별 제목 · 설명 · 검색엔진 등록</td></tr>
            <tr><th scope="row">오픈 후</th><td>혼자 찾아가며 운영</td><td class="is-good">1:1 운영 교육 후 직접 수정</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 진행 과정 -->
  <section class="sec sec--dark" id="process" aria-labelledby="process-title">
    <div class="inner">
      <div class="head" data-reveal>
        <p class="label">PROCESS</p>
        <h2 id="process-title" class="h2">아임웹 홈페이지 제작,<br>이렇게 진행됩니다.</h2>
      </div>
      <ol class="steps">
        <li><b>STEP 1</b><h3>상담 · 자료 정리</h3><p>필요한 메뉴와 자료를 함께 정리합니다.</p></li>
        <li><b>STEP 2</b><h3>구조 설계</h3><p>메뉴와 페이지별 내용을 설계합니다.</p></li>
        <li><b>STEP 3</b><h3>디자인</h3><p>시안으로 방향을 맞추고 수정합니다.</p></li>
        <li><b>STEP 4</b><h3>아임웹 세팅</h3><p>디자인을 아임웹에 구현하고 기능을 설정합니다.</p></li>
        <li><b>STEP 5</b><h3>오픈 · 운영 교육</h3><p>도메인 연결 후 직접 수정하는 법을 안내합니다.</p></li>
      </ol>
    </div>
  </section>

  <LatestColumns title="아임웹 홈페이지 제작 전에 읽어보세요" />

  <!-- FAQ -->
  <section class="sec sec--soft" id="faq" aria-labelledby="faq-title">
    <div class="inner inner--narrow">
      <div class="head" data-reveal>
        <p class="label">FAQ</p>
        <h2 id="faq-title" class="h2">아임웹 홈페이지 제작<br>자주 묻는 질문</h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <Contact
    title="만들고 싶은 홈페이지를 편하게 알려주세요."
    lead="정리되지 않은 이야기도 괜찮습니다. 필요한 메뉴와 구성부터 함께 정리해 드립니다. 상담은 무료입니다."
  />
</Base>
